rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roleDoc() {
      return get(/databases/$(database)/documents/rollen/$(request.auth.uid));
    }

    function hasRole(roleName) {
      return signedIn()
        && exists(/databases/$(database)/documents/rollen/$(request.auth.uid))
        && roleDoc().data.role == roleName;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isStaff() {
      return hasRole('staff');
    }

    function isGangDisplay() {
      return hasRole('display-gang');
    }

    function isTeacherRoomDisplay() {
      return hasRole('display-lerarenkamer');
    }

    function mayReadPresence() {
      return isAdmin() || isStaff() || isGangDisplay() || isTeacherRoomDisplay();
    }

    function mayReadInternalExtras() {
      return isAdmin() || isStaff() || isTeacherRoomDisplay();
    }

    // Roltoekenning is nooit zelfservice. Alleen de admin kan rollen beheren.
    match /rollen/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if isAdmin();
    }

    // Minimale algemene medewerkersdata: naam + zichtbaar.
    match /medewerkers/{medewerkerId} {
      allow read: if mayReadPresence();
      allow create, update, delete: if isAdmin();
    }

    // Oude productiecollectie: na migratie niet meer nodig.
    // Alleen admin kan hem tijdelijk lezen voor controle/migratie.
    match /aanwezigheid/{recordId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    // Eén document per medewerker, uitsluitend actuele status.
    match /actuele_status/{medewerkerId} {
      allow read: if mayReadPresence();
      allow create, update: if (isAdmin() || isStaff())
        && request.resource.data.keys().hasOnly(['naam', 'status'])
        && request.resource.data.naam is string
        && request.resource.data.status in ['Aanwezig', 'Afwezig'];
      allow delete: if isAdmin();
    }

    // Alleen interne rollen; gangdisplays krijgen deze collectie niet.
    match /mededelingen/{mededelingId} {
      allow read: if mayReadInternalExtras();
      allow create, update, delete: if isAdmin();
    }

    // Alleen interne rollen; gangdisplays krijgen deze collectie niet.
    match /verjaardagen/{verjaardagId} {
      allow read: if mayReadInternalExtras();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['naam', 'dag', 'maand'])
        && request.resource.data.naam is string
        && request.resource.data.dag is int
        && request.resource.data.dag >= 1
        && request.resource.data.dag <= 31
        && request.resource.data.maand is int
        && request.resource.data.maand >= 1
        && request.resource.data.maand <= 12;
      allow delete: if isAdmin();
    }

    // E-mail en eventuele andere beheerdata is uitsluitend voor de admin.
    match /medewerkers_prive/{medewerkerId} {
      allow read, write: if isAdmin();
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
