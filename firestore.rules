rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function account() {
      return get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && account().role == 'admin';
    }

    function isStaff() {
      return signedIn() &&
        (account().role == 'staff' || account().role == 'admin');
    }

    function isDisplay() {
      return signedIn() && account().role == 'display';
    }

    function isLerarenkamerDisplay() {
      return isDisplay() && account().displayType == 'lerarenkamer';
    }

    match /accounts/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /actuele_status/{uid} {
      allow read: if signedIn();

      allow create, update: if isAdmin() ||
        (isStaff() &&
         request.auth.uid == uid &&
         request.resource.data.keys().hasOnly(['aanwezig']) &&
         request.resource.data.aanwezig is bool);

      allow delete: if isAdmin();
    }

    match /mededelingen/{id} {
      allow read: if isStaff() || isLerarenkamerDisplay();
      allow write: if isAdmin();
    }

    match /verjaardagen/{id} {
      allow read: if isStaff() || isLerarenkamerDisplay();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
